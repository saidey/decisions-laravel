{
    "name": "decisions-ai/laravel",
    "description": "A Laravel client for decisions.site monitoring.",
    "type": "library",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-zlib": "*",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "DecisionsAi\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DecisionsAi\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DecisionsAi\\Laravel\\DecisionsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
